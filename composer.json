{
    "name": "vadim/cbr-rates",
    "description": "CBR exchange rates and historical imports",
    "type": "project",
    "license": "proprietary",
    "require": {
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.5",
        "ext-amqp": "*",
        "ext-bcmath": "*",
        "ext-dom": "*",
        "ext-pdo": "*",
        "nelmio/api-doc-bundle": "^5.0",
        "php": "~8.5.0",
        "symfony/amqp-messenger": "8.1.*",
        "symfony/asset": "8.1.*",
        "symfony/clock": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12.5",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@php bin/console doctrine:database:create --env=test --if-not-exists --no-interaction",
            "@php bin/console doctrine:migrations:migrate --env=test --no-interaction",
            "phpunit --exclude-group rabbitmq"
        ],
        "test:broker": [
            "@php bin/console doctrine:database:create --env=test --if-not-exists --no-interaction",
            "@php bin/console doctrine:migrations:migrate --env=test --no-interaction",
            "phpunit --testsuite broker"
        ],
        "check": [
            "@composer validate --strict",
            "@cs:check",
            "@analyse",
            "@php bin/console lint:container",
            "@php bin/console lint:yaml config",
            "@php bin/console doctrine:schema:validate",
            "@test"
        ],
        "cs:fix": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "analyse": [
            "@php tests/phpstan-object-manager.php",
            "phpstan analyse --no-progress"
        ]
    }
}
